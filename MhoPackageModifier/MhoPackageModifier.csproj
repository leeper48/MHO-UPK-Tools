<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.53.0</Version>
    <AssemblyName>MHO_UPK_Mod</AssemblyName>
    <Product>MHO Package Modifier</Product>
    <AssemblyTitle>MHO Package Modifier</AssemblyTitle>
    <RootNamespace>MhoPackageModifier</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- App icon (Explorer, taskbar, title bars): yellow lightning bolt on a blue circle. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
  </ItemGroup>
  <ItemGroup>
    <!-- MHO Extended Mod Manager reuses the package code, the write path and the theme. -->
    <InternalsVisibleTo Include="MHO_Ext_ModManager" />
  </ItemGroup>
  <ItemGroup>
    <!-- Zone recipe inputs (placeholder FBX, facade textures), used by the build-zone command and the Zones tab. -->
    <None Include="ZoneData\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The manual (Help button / F1). -->
    <None Include="Help\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
