<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Microsoft.VisualBasic.FileIO: removing a mod sends its folder to the Recycle Bin. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.37.111</Version>
    <AssemblyName>MHO_Ext_ModManager</AssemblyName>
    <Product>MHO Extended Mod Manager</Product>
    <AssemblyTitle>MHO Extended Mod Manager</AssemblyTitle>
    <RootNamespace>MhoExtendedModManager</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- MHO_UPK_Mod is referenced as a library; publishing with -r would otherwise stop on NETSDK1151. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- App icon: a comic "POW" burst with an M (Assets\make_icon.py draws every size). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Package reader/writer, the one game-folder write path (MeshImport.WriteLive), undo history, theme. -->
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <ProjectReference Include="..\MhoPackageModifier\MhoPackageModifier.csproj" />
    <!-- Skeletal meshes (costumes) for the preview's 3D view: AnimExportCli's reader. -->
    <ProjectReference Include="..\AnimExportCli\AnimExportCli.csproj" />
    <!-- CRC-32 of whole packages (the stock checksum list and mod copies). -->
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <!-- Patched versions of packages AssimpNet pulls in at 4.3.0 (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj). -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <!-- Installing .7z / .rar mod archives (MHModManager accepted .zip and .7z). -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stock package checksums for new users without MHModManager (see StockData\README.txt). -->
    <None Include="StockData\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- What's new, shown by Settings → Changelog. -->
    <None Include="CHANGELOG.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The manual (Help button / F1). Named Manual\, not Help\: MPM's Help\ is dropped from this app's output below. -->
    <None Include="Manual\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The hero portrait backdrop (Kurt's blue hex grid, 180x136) behind icon-creator portraits. -->
    <None Include="Assets\herohor_bluebackdrop.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Wwise Vorbis codebooks for WwiseVorbis.cs (from ww2ogg, BSD; voice playback in the Editor). -->
    <None Include="Assets\packed_codebooks_aoTuV_603.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- MPM's zone recipe inputs and manual would otherwise be copied here too (27 MB); this app doesn't use them. -->
  <Target Name="DropMpmContent" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('ZoneData')) Or $([System.String]::Copy('%(TargetPath)').StartsWith('Help'))" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('ZoneData')) Or $([System.String]::Copy('%(TargetPath)').StartsWith('Help'))" />
    </ItemGroup>
  </Target>
  <Target Name="DropMpmContentFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('ZoneData')) Or $([System.String]::Copy('%(RelativePath)').StartsWith('Help'))" />
    </ItemGroup>
  </Target>
</Project>
